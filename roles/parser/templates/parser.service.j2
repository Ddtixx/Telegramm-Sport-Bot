[Unit]
Description=VkusVill Parser
After=network.target docker.service
Wants=docker.service

[Service]
Type=oneshot
User={{ parser_owner }}
Group={{ parser_owner_group }}
WorkingDirectory={{ parser_dir }}
Environment=ENV_FILE={{ parser_project_dir }}/.env
ExecStart={{ parser_venv_dir }}/bin/python {{ parser_dir }}/collect_products.py
StandardOutput=journal
StandardError=journal
