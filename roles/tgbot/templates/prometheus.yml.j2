global:
  scrape_interval: 10s
  evaluation_interval: 10s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['alertmanager:{{ tgbot_alertmanager_port }}']

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:{{ tgbot_prometheus_port }}']

  - job_name: 'node-exporter'
    static_configs:
      - targets:
{% for target in tgbot_prometheus_targets %}
          - '{{ target }}'
{% endfor %}
