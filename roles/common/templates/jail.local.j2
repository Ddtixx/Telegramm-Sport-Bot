[DEFAULT]
bantime = {{ common_fail2ban_bantime }}
findtime = {{ common_fail2ban_findtime }}
maxretry = {{ common_fail2ban_maxretry }}
ignoreip = {{ common_fail2ban_ignoreip | join(' ') }}

[sshd]
enabled = {{ common_fail2ban_sshd_enabled | ternary('true', 'false') }}
port = ssh
filter = sshd
logpath = /var/log/auth.log
maxretry = {{ common_fail2ban_sshd_maxretry }}
bantime = {{ common_fail2ban_bantime }}
