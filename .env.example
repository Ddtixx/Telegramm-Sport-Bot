# Telegram Bot API token (get it from @BotFather)
API=your_telegram_bot_token_here

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Alertmanager Telegram bot token (separate bot for alerts)
ALERTMANAGER_BOT_TOKEN=your_alert_bot_token_here

# Alertmanager Telegram chat ID to send alerts to
ALERTMANAGER_CHAT_ID=your_chat_id_here

# Grafana credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me
